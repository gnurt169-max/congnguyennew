# ==============================================================================
# TÊN MIỀN CHÍNH THỨC & URL ỨNG DỤNG FRONTEND (.env.example)
# ==============================================================================
APP_URL="https://congnguyen.com.vn"
CLIENT_URL="https://congnguyen.com.vn"
BASE_URL="https://congnguyen.com.vn"

# Next.js Public Environment Variables
NEXT_PUBLIC_APP_URL="https://congnguyen.com.vn"
NEXT_PUBLIC_API_URL="/api/v1"
NEXT_PUBLIC_API_URL_PROD="https://congnguyen.com.vn/api/v1"
INTERNAL_API_URL="http://127.0.0.1:4000/api/v1"
NEXT_PUBLIC_SITE_NAME="Công Nguyên Machinery"
NEXT_PUBLIC_HOTLINE="0903768871"

# ==============================================================================
# CẤU HÌNH ISR & ON-DEMAND REVALIDATION (.env.example)
# ==============================================================================
BACKEND_API_URL="http://127.0.0.1:4000/api/v1"
REVALIDATE_SECRET_TOKEN="cong_nguyen_isr_secret_token_2026"
NEXT_PUBLIC_REVALIDATE_SECRET_TOKEN="cong_nguyen_isr_secret_token_2026"

# ==============================================================================
# THIRD-PARTY SCRIPTS & ANALYTICS (Tối ưu hóa Core Web Vitals)
# ==============================================================================
# Nhóm 1: afterInteractive (Nạp sau khi trang tương tác, không chặn FCP/LCP)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Nhóm 2: lazyOnload (Nạp khi tài nguyên rảnh/idle, giảm triệt để TBT và INP)
NEXT_PUBLIC_FB_PIXEL_ID="XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_ZALO_OA_ID="XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_HOTJAR_ID="XXXXXXX"
NEXT_PUBLIC_HOTJAR_SV="6"

# Tùy chọn: Bật analytics khi dev localhost (Mặc định: false - chỉ bật trên production)
NEXT_PUBLIC_ENABLE_ANALYTICS_DEV="false"
