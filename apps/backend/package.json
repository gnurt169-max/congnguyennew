{
  "name": "@industrial-bakery/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "prestart": "kill -9 $(lsof -t -i:4000) 2>/dev/null || true",
    "start": "kill -9 $(lsof -t -i:4000) 2>/dev/null || true; nest start",
    "prestart:dev": "kill -9 $(lsof -t -i:4000) 2>/dev/null || true",
    "start:dev": "kill -9 $(lsof -t -i:4000) 2>/dev/null || true; nest start --watch",
    "prestart:debug": "kill -9 $(lsof -t -i:4000) 2>/dev/null || true",
    "start:debug": "kill -9 $(lsof -t -i:4000) 2>/dev/null || true; nest start --debug --watch",
    "prestart:prod": "kill -9 $(lsof -t -i:4000) 2>/dev/null || true",
    "start:prod": "kill -9 $(lsof -t -i:4000) 2>/dev/null || true; node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@industrial-bakery/shared-types": "*",
    "@nestjs/common": "^10.4.5",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.5",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.5",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.5",
    "@types/sharp": "^0.31.1",
    "prisma": "^5.21.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
